# ./scripts/up.sh generates random credentials into .env on first run.
NEKO_TOKEN=replace-with-at-least-32-random-characters
# VNC authentication uses the first eight characters. Use eight random ASCII characters.
NEKO_VNC_PASSWORD=changeMe
NEKO_BIND=127.0.0.1
NEKO_MCP_PORT=8080
NEKO_DESKTOP_PORT=6080
NEKO_RESOLUTION=1440x900
NEKO_MEMORY=4g
NEKO_CPUS=2
